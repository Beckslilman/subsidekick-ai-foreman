# Copy to backend/.env locally. Do not commit secrets.
# Names only — see docs/STACK.md for the fold path.

# --- Required for current FastAPI data routes (Mongo) ---
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=subsidekick

# --- Fold target: Supabase project subsidekick (ref vbcyzvlyfzapnifqrwlf) ---
# Unused by FastAPI routes today. Set on Vercel so /api/health can see them.
SUPABASE_URL=https://vbcyzvlyfzapnifqrwlf.supabase.co
# Publishable / anon: client + RLS. Never put the service role in the frontend.
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_ANON_KEY=
# Server-only (FastAPI). Never EXPO_PUBLIC_ / NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Already used by this API ---
GHL_ACCESS_TOKEN=
GHL_LOCATION_ID=
GHL_PUBLIC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+12295857126
# LLM key name as read today (vendor parked; do not add Emergent deploy docs)
EMERGENT_LLM_KEY=

# Production webhook hardening
# ALLOW_DEV_LOGIN=0
# TWILIO_SKIP_SIGNATURE_CHECK=0
# SKIP_BACKGROUND_JOBS=1
