{
  "expo": {
    "name": "SubSidekick",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.sidekickappbuild.ixq0iw",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Record voice notes for the AI foreman",
        "NSPhotoLibraryUsageDescription": "Attach jobsite photos to draft records",
        "NSCameraUsageDescription": "Attach jobsite photos to draft records"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.sidekickappbuild.ixq0iw",
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SubSidekick to record voice notes for the AI foreman."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach jobsite photos to change orders and back charges."
        }
      ],
      "@react-native-vector-icons/material-design-icons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
